From 697573f1b29f95b9e9f7bf0b8e79820ee2532e49 Mon Sep 17 00:00:00 2001
From: root <baimingcong@uniontech.com>
Date: Tue, 23 Jul 2024 10:57:26 +0800
Subject: [PATCH 172/360] arch: configs: mark CONFIG_FSCACHE as Y

This option is no longer a tristate (now a bool) since 6.8.

Signed-off-by: root <baimingcong@uniontech.com>
---
 arch/loongarch/configs/deepin_loongarch_desktop_defconfig | 2 +-
 arch/x86/configs/deepin_x86_desktop_defconfig             | 2 +-
 2 files changed, 2 insertions(+), 2 deletions(-)

diff --git a/arch/loongarch/configs/deepin_loongarch_desktop_defconfig b/arch/loongarch/configs/deepin_loongarch_desktop_defconfig
index 5d9d99843455..edb337ed1414 100644
--- a/arch/loongarch/configs/deepin_loongarch_desktop_defconfig
+++ b/arch/loongarch/configs/deepin_loongarch_desktop_defconfig
@@ -5667,7 +5667,7 @@ CONFIG_FUSE_FS=m
 CONFIG_CUSE=m
 CONFIG_VIRTIO_FS=m
 CONFIG_OVERLAY_FS=m
-CONFIG_FSCACHE=m
+CONFIG_FSCACHE=y
 CONFIG_FSCACHE_STATS=y
 CONFIG_CACHEFILES=m
 CONFIG_CACHEFILES_ONDEMAND=y
diff --git a/arch/x86/configs/deepin_x86_desktop_defconfig b/arch/x86/configs/deepin_x86_desktop_defconfig
index 75d885d05496..a7eb899a709b 100644
--- a/arch/x86/configs/deepin_x86_desktop_defconfig
+++ b/arch/x86/configs/deepin_x86_desktop_defconfig
@@ -5272,7 +5272,7 @@ CONFIG_CUSE=m
 CONFIG_VIRTIO_FS=m
 CONFIG_OVERLAY_FS=m
 CONFIG_OVERLAY_FS_XINO_AUTO=y
-CONFIG_FSCACHE=m
+CONFIG_FSCACHE=y
 CONFIG_FSCACHE_STATS=y
 CONFIG_CACHEFILES=m
 CONFIG_CACHEFILES_ONDEMAND=y
-- 
2.20.1

