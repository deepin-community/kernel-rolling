 CONFIG_NUMA=y
 CONFIG_ARCH_FORCE_MAX_ORDER=12
 CONFIG_ARCH_IOREMAP=y
@@ -60,6 +60,10 @@ CONFIG_CPU_HAS_LSX=y
 CONFIG_CPU_HAS_LASX=y
