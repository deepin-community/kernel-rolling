+
+// TODO: need to support full qpairs
+#define TSSE_PF_MAX_QPAIR_NUM 16
+
+#define TSSE_PF_MAX_IRQ_NUM 96
+#define TSSE_PF_QPAIR_START_IRQ_VECTOR 32
+
+#define TSSE_SRIOV_PF_MAX_QPAIR_NUM 0
